        <exclude domain="sharedpref" path="classroom_settings.xml" />
        <exclude domain="sharedpref" path="neuq_secrets.xml" />
        <exclude domain="sharedpref" path="neuq_secrets_fallback.xml" />
        <exclude domain="file" path="cloud_cache.txt" />
